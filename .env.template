# RASTRO — variables de entorno.
# Todas son opcionales: si se dejan comentadas, la app usa los valores por defecto de lib/config.ts.
# No pongas secretos en este archivo; cópialo a .env y edita ahí.

# Puerto publicado por docker compose
RASTRO_PORT=3000

# Estilo del mapa base (MapLibre). Se incrusta en el build del cliente.
# NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Fuentes de datos
# RASTRO_RNPDNO_CSV_URL=
# RASTRO_VAD_BORRADOS_CSV_URL=
# RASTRO_RECONSTRUCCION_AGGREGADOS_URL=/data/reconstruccion-agregados.json

# Feeds RSS (lista separada por comas)
# RASTRO_RSS_FEEDS=https://www.animalpolitico.com/feed/,https://www.proceso.com.mx/rss

# Identificación ante los servidores consultados (incluye una vía de contacto)
# RASTRO_USER_AGENT=RASTRO/0.3 (+https://github.com/aztlan1701/rastro)

# Monitor OSINT (/api/monitor)
# RASTRO_MONITOR_KEYWORDS=desaparec,hallazgo,fosa,buscadoras,localizad
# RASTRO_MONITOR_ESTADOS=
# RASTRO_ALERT_WEBHOOK_URL=
# Secreto que la petición debe presentar (Authorization: Bearer <token>) para disparar el webhook.
# Sin token configurado el webhook nunca se dispara. Defínelo solo en .env, nunca en este archivo.
# RASTRO_MONITOR_TOKEN=

# Caché y límite de tasa compartidos entre instancias (opcional; sin esto se usa memoria local).
# Son secretos: defínelos solo en .env.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Dónde está publicado el código de ESTA instalación. Si despliegas una versión
# modificada, la licencia AGPL te obliga a publicarla: apunta aquí a tu repositorio.
# NEXT_PUBLIC_RASTRO_SOURCE_URL=https://github.com/aztlan1701/rastro
